    - "\uC21C\uB300\uB294 \uC5B4\uB514 \uC788\uB294\uAC70\uC57C?"
  completeQuestDialogue:
    dialogues:
    - "\uC21C\uB300 \uB0C4\uC0C8\uB97C \uB9E1\uACE0 \uB300\uC7A5\uB2D8\uC774 \uB3CC\uC544\uC624\uC2E4\uAE4C?"
